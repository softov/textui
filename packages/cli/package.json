{
  "name": "@textui/cli",
  "version": "0.1.0",
  "description": "TextUI developer CLI - init, add, create, doctor - and primitives for building your own",
  "keywords": [
    "terminal",
    "tui",
    "cli",
    "scaffold",
    "generator",
    "init",
    "component-registry"
  ],
  "homepage": "https://softov.github.io/textui/",
  "bugs": {
    "url": "https://github.com/softov/textui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/textui.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Softov <softov@brbyte.com>",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "textui": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@textui/core": "workspace:^",
    "@textui/terminal": "workspace:^",
    "@textui/widgets": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
