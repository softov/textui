{
  "name": "@textui/terminal",
  "version": "0.1.0",
  "description": "Terminal adapters, capability detection, ANSI writing and input decoding for TextUI",
  "keywords": [
    "terminal",
    "tui",
    "ansi",
    "tty",
    "capabilities",
    "kitty-keyboard",
    "input",
    "escape-codes"
  ],
  "homepage": "https://softov.github.io/textui/",
  "bugs": {
    "url": "https://github.com/softov/textui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/textui.git",
    "directory": "packages/terminal"
  },
  "license": "MIT",
  "author": "Softov <softov@brbyte.com>",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/virtual.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@textui/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
