{
  "name": "@textui/textide",
  "version": "0.1.0",
  "private": true,
  "description": "An IDE that runs in a terminal, built on TextUI",
  "keywords": [
    "terminal",
    "tui",
    "ide",
    "editor",
    "text-editor",
    "console",
    "textui"
  ],
  "homepage": "https://softov.github.io/textui/",
  "bugs": {
    "url": "https://github.com/softov/textui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/textui.git",
    "directory": "packages/textide"
  },
  "license": "MIT",
  "author": "Softov <softov@brbyte.com>",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "textide": "./dist/main.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:watch": "node scripts/dev.mjs --watch",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@textui/core": "workspace:^",
    "@textui/documents": "workspace:^",
    "@textui/terminal": "workspace:^",
    "@textui/textide-git": "workspace:^",
    "@textui/widgets": "workspace:^"
  },
  "devDependencies": {
    "@textui/testing": "workspace:^",
    "esbuild": "^0.25.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
